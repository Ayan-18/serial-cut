      "start_time": 0.0,
      "end_time": 5.0,
      "text": "Ранее в сериале.",
      "speaker_label": "Narrator"
    },
    {
      "start_time": 10.0,
      "end_time": 15.0,
      "text": "Ты правда скрывал это от нас?",
      "speaker_label": "Аня"
    },
    {
      "start_time": 15.8,
      "end_time": 22.0,
      "text": "Я пытался защитить семью.",
      "speaker_label": "Максим"
    },
    {
      "start_time": 23.0,
      "end_time": 32.0,
      "text": "Защитить? Ты разрушил всё!",
      "speaker_label": "Аня"
    },
    {
      "start_time": 33.0,
      "end_time": 48.0,
      "text": "Тогда слушай: деньги всё ещё у меня.",
      "speaker_label": "Максим"
    },
    {
      "start_time": 70.0,
      "end_time": 75.0,
      "text": "Ну, мы пришли.",
      "speaker_label": "Аня"
    },
    {
      "start_time": 76.0,
      "end_time": 80.0,
      "text": "Да.",
      "speaker_label": "Максим"
    },
    {
      "start_time": 81.0,
      "end_time": 85.0,
      "text": "Пошли.",
      "speaker_label": "Аня"
    },
    {
      "start_time": 108.0,
      "end_time": 113.0,
      "text": "Подожди, ключ не от двери.",
      "speaker_label": "Максим"
    },
    {
      "start_time": 114.0,
      "end_time": 120.0,
      "text": "Тогда от чего?",
      "speaker_label": "Аня"
    },
    {
      "start_time": 121.0,
      "end_time": 132.0,
      "text": "От сейфа, где лежит письмо от отца.",
      "speaker_label": "Максим"
    },
    {
      "start_time": 133.0,
      "end_time": 147.0,
      "text": "Значит он всё это время был жив?",
      "speaker_label": "Аня"
    }
  ],
